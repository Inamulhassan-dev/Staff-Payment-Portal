# ─── JWT / Auth ────────────────────────────────────────────────────────────────
# REQUIRED in production: replace with a long random string
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-production

# JWT signing algorithm (default: HS256)
ALGORITHM=HS256

# Token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero-config) – DB file is created automatically on first run
DATABASE_URL=sqlite:///./staff_payment.db

# PostgreSQL example (uncomment and fill in for production deployments):
# DATABASE_URL=postgresql://user:password@localhost:5432/staff_payment
